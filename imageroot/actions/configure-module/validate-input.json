{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Configure kumomta",
    "$id": "http://nethserver.org/json-schema/task/input/kumomta/configure-module",
    "description": "Configure KumoMTA. Every field is optional: a missing field keeps its current value. Write-only secrets are never returned by get-configuration.",
    "examples": [
        {
            "hostname": "mx.example.org",
            "lets_encrypt": false,
            "inbound_enabled": true,
            "inbound_port": 25,
            "submission_enabled": true,
            "submission_port": 587,
            "relay_networks": [
                "192.168.1.0/24"
            ],
            "smtp_users": [
                {
                    "username": "app1",
                    "password": "Secret,1234"
                }
            ],
            "domains": [
                {
                    "domain": "example.org",
                    "selector": "kumo1"
                }
            ]
        }
    ],
    "type": "object",
    "properties": {
        "hostname": {
            "type": "string",
            "format": "hostname",
            "pattern": "\\.",
            "maxLength": 253,
            "description": "Fully qualified host name of the MTA: SMTP banner, EHLO name and TLS certificate name"
        },
        "lets_encrypt": {
            "type": "boolean",
            "description": "Request a Let's Encrypt certificate for the host name (and the metrics host name)"
        },
        "inbound_enabled": {
            "type": "boolean",
            "description": "Enable the inbound (MX) SMTP listener"
        },
        "inbound_port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535,
            "description": "Port of the inbound listener, normally 25"
        },
        "submission_enabled": {
            "type": "boolean",
            "description": "Enable the submission listener (STARTTLS + AUTH)"
        },
        "submission_port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535,
            "description": "Port of the submission listener, normally 587"
        },
        "max_message_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1024,
            "description": "Maximum message size, in MiB"
        },
        "relay_networks": {
            "type": "array",
            "items": {
                "type": "string",
                "maxLength": 64
            },
            "description": "IP addresses and CIDR networks allowed to relay without authentication"
        },
        "cluster_relay": {
            "type": "boolean",
            "description": "Offer the MTA as smarthost to the cluster: relay from the cluster network and publish the submission service"
        },
        "trust_loopback": {
            "type": "boolean",
            "description": "Relay without SMTP AUTH from the loopback of the node (127.0.0.0/8, ::1): other services of the host can send through the MTA"
        },
        "smtp_users": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "username"
                ],
                "properties": {
                    "username": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9._@+-]{1,128}$"
                    },
                    "password": {
                        "type": "string",
                        "maxLength": 256,
                        "description": "Empty to keep the current password"
                    }
                },
                "additionalProperties": false
            },
            "description": "SMTP AUTH credentials of the submitting clients. Users not listed are removed"
        },
        "domains": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "domain"
                ],
                "properties": {
                    "domain": {
                        "type": "string",
                        "minLength": 3,
                        "maxLength": 253
                    },
                    "selector": {
                        "type": "string",
                        "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
                    },
                    "tenant": {
                        "type": "string",
                        "maxLength": 64,
                        "description": "KumoMTA tenant of the messages of this domain sent by integrations without a tenant of their own"
                    }
                },
                "additionalProperties": false
            },
            "description": "Sending domains of the administrator, signed with DKIM. The domains added by integrations through the API are not listed here and are kept"
        },
        "inbound_routes": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "domain",
                    "host"
                ],
                "properties": {
                    "domain": {
                        "type": "string",
                        "minLength": 3,
                        "maxLength": 253
                    },
                    "host": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 253
                    },
                    "port": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 65535
                    }
                },
                "additionalProperties": false
            },
            "description": "Domains accepted from anyone and relayed to an internal server"
        },
        "smarthost_enabled": {
            "type": "boolean"
        },
        "smarthost_host": {
            "type": "string",
            "maxLength": 253
        },
        "smarthost_port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
        },
        "smarthost_tls": {
            "type": "string",
            "enum": [
                "required",
                "required_insecure",
                "opportunistic",
                "disabled"
            ]
        },
        "smarthost_username": {
            "type": "string",
            "maxLength": 256
        },
        "smarthost_password": {
            "type": "string",
            "maxLength": 1024,
            "description": "Write only. Empty keeps the current password"
        },
        "shaping": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "domain"
                ],
                "properties": {
                    "domain": {
                        "type": "string",
                        "minLength": 3,
                        "maxLength": 253
                    },
                    "connection_limit": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 10000
                    },
                    "max_message_rate": {
                        "type": "string",
                        "maxLength": 32
                    },
                    "max_deliveries_per_connection": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 100000
                    }
                },
                "additionalProperties": false
            },
            "description": "Per-destination traffic shaping"
        },
        "retry_interval": {
            "type": "string",
            "maxLength": 32,
            "description": "First retry interval of deferred messages, e.g. 20m"
        },
        "max_age": {
            "type": "string",
            "maxLength": 32,
            "description": "Messages still undelivered after this time bounce, e.g. 5d"
        },
        "webhook_enabled": {
            "type": "boolean"
        },
        "webhook_url": {
            "type": "string",
            "maxLength": 2048
        },
        "webhook_token": {
            "type": "string",
            "maxLength": 4096,
            "description": "Write only bearer token. Empty keeps the current one"
        },
        "webhook_token_clear": {
            "type": "boolean",
            "description": "Remove the bearer token"
        },
        "webhook_record_types": {
            "type": "array",
            "items": {
                "type": "string",
                "enum": [
                    "Reception",
                    "Delivery",
                    "Bounce",
                    "TransientFailure",
                    "Expiration",
                    "AdminBounce",
                    "OOB",
                    "Feedback",
                    "Rejection"
                ]
            }
        },
        "vault_enabled": {
            "type": "boolean",
            "description": "Read the secrets from OpenBao/Vault (KV v2)"
        },
        "vault_address": {
            "type": "string",
            "maxLength": 2048,
            "description": "VAULT_ADDR, e.g. https://vault.example.org"
        },
        "vault_token": {
            "type": "string",
            "maxLength": 4096,
            "description": "VAULT_TOKEN. Write only, empty keeps the current token"
        },
        "vault_mount": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._/-]{1,128}$"
        },
        "vault_path": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._/-]{1,256}$"
        },
        "vault_key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{0,128}$",
            "description": "Field name of the secrets, empty for the KumoMTA default 'key'"
        },
        "vault_auth": {"type": "string", "enum": ["token", "provisioned"], "description": "token: the pasted VAULT_TOKEN; provisioned: the module's own token issued by an ns8-openbao instance (client provisioning)"},
        "vault_provider": {"type": "string", "pattern": "^([a-z][a-z0-9-]{0,62}[0-9])?$", "description": "Module ID of the ns8-openbao instance of provisioned mode, e.g. openbao1"},
        "metrics_host": {
            "type": "string",
            "maxLength": 253,
            "description": "Host name of the Traefik route to /metrics, empty to disable"
        },
        "metrics_password": {
            "type": "string",
            "maxLength": 256,
            "description": "Write only password of the 'metrics' user"
        },
        "metrics_allowlist": {
            "type": "array",
            "items": {
                "type": "string",
                "maxLength": 64
            }
        },
        "metrics_public": {
            "type": "boolean",
            "description": "Metrics route reachable from the internet; false limits it to private networks, the cluster network and metrics_allowlist"
        },
        "sink_enabled": {
            "type": "boolean",
            "description": "Testing only: accept and discard every outbound message instead of delivering it (Delivery records are still logged)"
        },
        "webhook_signing_secret": {
            "type": "string",
            "maxLength": 4096,
            "description": "Write only HMAC-SHA256 secret: the webhook requests carry X-KumoMTA-Signature. Empty keeps the current one"
        },
        "webhook_signing_secret_clear": {
            "type": "boolean",
            "description": "Remove the signing secret"
        },
        "integrations": {
            "type": "array",
            "description": "Integration credentials of sending platforms, distinct from the module's admin API user. Integrations not listed are removed",
            "items": {
                "type": "object",
                "required": [
                    "name"
                ],
                "properties": {
                    "name": {
                        "type": "string",
                        "pattern": "^[a-z0-9][a-z0-9-]{2,31}$",
                        "description": "User name of the credential (HTTP basic auth, SMTP AUTH)"
                    },
                    "password": {
                        "type": "string",
                        "maxLength": 256,
                        "description": "Write only, at least 16 characters. Empty keeps the current one"
                    },
                    "tenant": {
                        "type": "string",
                        "maxLength": 64,
                        "description": "KumoMTA tenant forced on the messages of this credential; empty makes a multi-tenant credential: the X-Tenant header (or the tenant of the sending domain) chooses"
                    },
                    "tenant_prefix": {
                        "type": "string",
                        "maxLength": 32,
                        "pattern": "^[A-Za-z0-9._-]*$",
                        "description": "Multi-tenant credential: the tenant labels it may use (X-Tenant header, tenant of its domains) must start with this prefix; empty allows any label"
                    },
                    "scopes": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "enum": [
                                "inject",
                                "smtp",
                                "domains"
                            ]
                        },
                        "description": "inject: HTTP injection API; smtp: SMTP AUTH; domains: sending domain management API"
                    },
                    "max_message_rate": {
                        "type": "string",
                        "maxLength": 32,
                        "description": "Sending rate, e.g. 1000/h; empty for no limit. Fixed tenant: the rate of that tenant. Multi-tenant credential: the rate of each of its tenants"
                    },
                    "max_domains": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 1000000,
                        "description": "Sending domains the credential may add through the domain API; 0 for no limit"
                    }
                },
                "additionalProperties": false
            }
        },
        "api_host": {
            "type": "string",
            "maxLength": 253,
            "description": "Host name of the HTTPS API routes for the integrations (/api/inject/v1 and /api/v1), empty to disable"
        },
        "api_allowlist": {
            "type": "array",
            "items": {
                "type": "string",
                "maxLength": 64
            },
            "description": "Optional networks allowed to reach the API routes"
        },
        "require_verified_domains": {
            "type": "boolean",
            "description": "Integrations can send only from verified sending domains"
        },
        "spf_include": {
            "type": "string",
            "maxLength": 253,
            "description": "SPF mechanism to publish and check, e.g. include:_spf.example.org; empty for a:<hostname>"
        },
        "bounce_domain": {
            "type": "string",
            "maxLength": 253,
            "description": "Return path, bounce and feedback-loop domain handled by this MTA, empty to disable"
        },
        "cluster_store": {
            "type": "string",
            "enum": [
                "none",
                "valkey",
                "manual"
            ],
            "description": "Shared throttle store of a multi-node cluster: none (standalone), valkey (an ns8-valkey instance) or manual (any Redis or Valkey). See docs/cluster.md"
        },
        "cluster_valkey": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^([a-z][a-z0-9-]*[0-9]+)?$",
            "description": "Module ID of the ns8-valkey instance, with cluster_store valkey"
        },
        "cluster_redis_nodes": {
            "type": "array",
            "maxItems": 16,
            "items": {
                "type": "string",
                "maxLength": 255
            },
            "description": "Manual store: redis:// or rediss:// URLs without credentials. More than one URL means a Redis Cluster"
        },
        "cluster_redis_username": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._@+-]*$",
            "description": "Manual store: ACL user name, empty for the default user"
        },
        "cluster_redis_password": {
            "type": "string",
            "maxLength": 512,
            "description": "Manual store: password (write only). A local 0600 file, or OpenBao <path>/cluster_redis when OpenBao is on"
        },
        "cluster_redis_password_clear": {
            "type": "boolean",
            "description": "Manual store: remove the password"
        },
        "cluster_redis_cluster": {
            "type": "boolean",
            "description": "Manual store: use the Redis Cluster protocol with a single URL"
        },
        "cluster_join": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^([a-z][a-z0-9-]*[0-9]+)?$",
            "description": "Copy the cluster settings (and the manual store password) of this kumomta instance, through its reveal-cluster-settings action"
        },
        "tsa_enabled": {
            "type": "boolean",
            "description": "Run the traffic shaping automation daemon (tsa-daemon). Clustered: it listens on the cluster VPN address and receives the log records of every peer of the same store"
        },
        "sending_ips": {
            "type": "array",
            "maxItems": 64,
            "description": "Sending IPs (egress sources of the default pool) with their overall limits and per-provider overrides. Empty: the default route, no per-IP limits",
            "items": {
                "type": "object",
                "required": [
                    "address"
                ],
                "additionalProperties": false,
                "properties": {
                    "address": {
                        "type": "string",
                        "maxLength": 45,
                        "description": "Local IPv4 or IPv6 address, empty for the address of the default route"
                    },
                    "ehlo_domain": {
                        "type": "string",
                        "maxLength": 253
                    },
                    "weight": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 100
                    },
                    "providers": {
                        "type": "array",
                        "maxItems": 64,
                        "items": {
                            "type": "object",
                            "required": [
                                "provider"
                            ],
                            "additionalProperties": false,
                            "properties": {
                                "provider": {
                                    "type": "string",
                                    "enum": [
                                        "google",
                                        "outlook",
                                        "office365",
                                        "yahoo",
                                        "apple",
                                        "domain",
                                        "mx"
                                    ],
                                    "description": "A provider of the KumoMTA shaping defaults, a destination domain, or an MX host name suffix"
                                },
                                "match": {
                                    "type": "string",
                                    "maxLength": 253,
                                    "description": "With domain: the domain; with mx: the MX host name suffix"
                                },
                                "per_minute": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "maximum": 1000000000,
                                    "description": "Messages per minute, 0 for no limit"
                                },
                                "per_hour": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "maximum": 1000000000,
                                    "description": "Messages per hour, 0 for no limit"
                                },
                                "per_day": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "maximum": 1000000000,
                                    "description": "Messages per day, 0 for no limit"
                                },
                                "max_connections": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "maximum": 100000,
                                    "description": "Concurrent connections, 0 for no limit"
                                }
                            }
                        }
                    },
                    "per_minute": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 1000000000,
                        "description": "Messages per minute, 0 for no limit"
                    },
                    "per_hour": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 1000000000,
                        "description": "Messages per hour, 0 for no limit"
                    },
                    "per_day": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 1000000000,
                        "description": "Messages per day, 0 for no limit"
                    },
                    "max_connections": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 100000,
                        "description": "Concurrent connections, 0 for no limit"
                    }
                }
            }
        }
    },
    "additionalProperties": false
}
