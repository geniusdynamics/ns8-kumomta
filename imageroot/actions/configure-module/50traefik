# Optional Traefik route to the Prometheus metrics of kumod: only the
# /metrics path of the metrics host name. kumod itself requires the HTTP
# basic credentials of the "metrics" user (acl.toml grants it /metrics and
# /metrics.json only); the admin API is never routed. kumod answers 401
# without a WWW-Authenticate challenge, so the route adds one: a browser
# then asks for the user and password. Without public access the route is
# limited to private networks and the cluster network.
#
# Optional API host name of the sending platforms: /api/inject goes to
# kumod (integration credentials, acl.toml grants them /api/inject only),
# /api/v1 to the domain management daemon (kumomta-api.service).

import os
import sys
import agent
import agent.tasks
import kumomta_ns8 as kumo

settings = kumo.load_settings()
route_id = os.environ['MODULE_ID'] + '-metrics'

if settings["metrics_host"]:
    route = {
        'instance': route_id,
        'url': 'http://127.0.0.1:' + os.environ['TCP_PORT'],
        'host': settings["metrics_host"],
        'path': '/metrics',
        'strip_prefix': False,
        'http2https': True,
        'lets_encrypt': settings["lets_encrypt"],
        'headers': {'response': {'WWW-Authenticate': 'Basic realm="KumoMTA metrics", charset="UTF-8"'}},
    }
    allowlist = kumo.metrics_allowlist(settings)
    if allowlist:
        route['ip_allowlist'] = allowlist
    agent.set_route(route)
else:
    traefik_id = agent.resolve_agent_id('traefik@node')
    if traefik_id:
        agent.tasks.run(agent_id=traefik_id, action='delete-route',
                        data={'instance': route_id}, extra={'isNotificationHidden': True})


def delete_route(instance):
    traefik_id = agent.resolve_agent_id('traefik@node')
    if traefik_id:
        agent.tasks.run(agent_id=traefik_id, action='delete-route',
                        data={'instance': instance}, extra={'isNotificationHidden': True})


api_routes = {
    os.environ['MODULE_ID'] + '-api-inject': ('/api/inject', os.environ['TCP_PORT']),
    os.environ['MODULE_ID'] + '-api': ('/api/v1', kumo.daemon_port()),
}
# .api-routes: the routes exist, delete them when the host name goes away
had_routes = os.path.exists(".api-routes")
for instance, (path, port) in api_routes.items():
    if settings["api_host"] and port:
        route = {
            'instance': instance,
            'url': f'http://127.0.0.1:{port}',
            'host': settings["api_host"],
            'path': path,
            'strip_prefix': False,
            'http2https': True,
            'lets_encrypt': settings["lets_encrypt"],
        }
        if settings["api_allowlist"]:
            route['ip_allowlist'] = settings["api_allowlist"]
        agent.set_route(route)
        open(".api-routes", "w").close()
    elif had_routes:
        delete_route(instance)
if not settings["api_host"] and had_routes:
    os.unlink(".api-routes")
