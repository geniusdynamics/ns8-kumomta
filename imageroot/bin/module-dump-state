# Before the backup: ask kumod to flush the spool (RocksDB) to disk, so the
# copy of the live volume is as consistent as possible. Best effort.

runagent python3 - <<'PYEOF' || :
import kumomta_ns8 as kumo
for spool in ("data", "meta"):
    try:
        kumo.api_request("/api/admin/spool-compact/v1", method="POST", body={"name": spool}, timeout=120)
    except Exception as ex:
        print(f"spool {spool} flush skipped: {ex}")
PYEOF
