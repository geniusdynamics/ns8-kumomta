{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Reveal the kumomta cluster settings",
    "$id": "http://nethserver.org/json-schema/task/output/kumomta/reveal-cluster-settings",
    "description": "Cluster settings of this instance for a joining kumomta instance, with the password of a manual throttle store. Role clusterpeer only.",
    "type": "object",
    "required": ["cluster_store", "cluster_valkey", "cluster_redis_nodes", "cluster_redis_username", "cluster_redis_cluster", "tsa_enabled", "cluster_redis_password"],
    "additionalProperties": false,
    "properties": {
        "cluster_store": {"type": "string", "enum": ["valkey", "manual"]},
        "cluster_valkey": {"type": "string"},
        "cluster_redis_nodes": {"type": "array", "items": {"type": "string"}},
        "cluster_redis_username": {"type": "string"},
        "cluster_redis_cluster": {"type": "boolean"},
        "tsa_enabled": {"type": "boolean"},
        "cluster_redis_password": {"type": "string"}
    }
}
