# Remove a sending domain (administrator or integration) and its local DKIM
# key files. A key stored in OpenBao is left there.

import json
import sys
import agent
import kumomta_ns8 as kumo

request = json.load(sys.stdin)
with kumo.settings_lock():
    settings = kumo.load_settings()
    try:
        dom = kumo.remove_domain(settings, request["domain"])
    except kumo.DomainError as ex:
        agent.set_status('validation-failed')
        json.dump([{'field': 'domain', 'parameter': 'domain', 'value': ex.value, 'error': ex.code}], fp=sys.stdout)
        sys.exit(3)
    kumo.save_settings(settings)
    kumo.apply_policy()
json.dump({"domain": dom["domain"], "removed": True}, fp=sys.stdout)
