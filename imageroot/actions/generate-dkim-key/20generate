# Install the DKIM key of a sending domain and return the DNS TXT record to
# publish. "source" says where the key comes from:
#
#   generate  a new key (default); with "rotate", replace the current one
#   shared    the key already at the OpenBao path (OpenBao on)
#   import    the PEM key of "private_key"
#   peer      the key of the same domain and selector on the kumomta
#             instance "peer" (its reveal-dkim-key action, role clusterpeer)
#
# With OpenBao the private key goes to OpenBao (KV v2,
# <vault_path>/dkim/<domain>/<selector>) and leaves the state directory; an
# existing local key is moved there unless "rotate" is set.
#
# Clustered (docs/cluster.md): the peers sign with the same key, so a key is
# imported, never overwritten. A key that already exists at a shared OpenBao
# path is never replaced, and rotation is refused (rotate with a new
# selector on every peer). The private key is never part of the output.

import json
import os
import sys
import agent
import kumomta_ns8 as kumo

request = json.load(sys.stdin)
domain = request["domain"].lower().rstrip(".")
source = request.get("source") or "generate"


def failed(field, value, code):
    agent.set_status('validation-failed')
    json.dump([{'field': field, 'parameter': field, 'value': value, 'error': code}], fp=sys.stdout)
    sys.exit(3)


def selector_for(settings):
    entry = kumo.find_domain(settings, domain)
    if entry is None:
        failed('domain', domain, 'domain_not_found')
    return entry["selector"]


pem = (request.get("private_key") or "") if source == "import" else None
if source == "peer":
    # Do not wait for another module's task while holding our settings lock.
    settings = kumo.load_settings()
    requested_selector = selector_for(settings)
    identity = kumo.store_identity(settings)
    peer = request.get("peer") or ""
    if not kumo.clustered(settings) or peer == os.environ.get("MODULE_ID") or peer not in kumo.kumomta_modules():
        failed('peer', peer, 'not_a_kumomta_instance')
    import agent.tasks
    ret = agent.tasks.run(agent_id=f"module/{peer}", action="reveal-dkim-key",
                          data={"domain": domain, "selector": requested_selector},
                          extra={"isNotificationHidden": True})
    if ret.get("exit_code") != 0:
        print(agent.SD_ERR + f"reveal-dkim-key of {peer} failed (exit code {ret.get('exit_code')})", file=sys.stderr)
        failed('peer', peer, 'peer_key_unavailable')
    pem = (ret.get("output") or {}).get("private_key") or ""

with kumo.settings_lock():
    settings = kumo.load_settings()
    selector = selector_for(settings)
    if source == "peer" and (selector != requested_selector or kumo.store_identity(settings) != identity
                             or not kumo.clustered(settings)):
        failed('peer', peer, 'peer_key_unavailable')
    try:
        location = kumo.install_dkim_key(settings, domain, selector, pem, source=source, rotate=request.get("rotate"))
    except kumo.DomainError as ex:
        field = {"cluster_rotation_refused": "rotate", "invalid_private_key": "private_key",
                 "openbao_read_failed": "domain"}.get(ex.code, "source")
        failed(field, ex.value, ex.code)
    except RuntimeError as ex:
        print(agent.SD_ERR + str(ex), file=sys.stderr)
        failed('domain', domain, 'openbao_write_failed')
    record = kumo.dkim_record(domain, selector)

# kumod caches the signers: a configuration epoch bump drops them
if agent.run_helper("systemctl", "--user", "-q", "is-active", "kumomta.service").returncode == 0:
    agent.run_helper("runagent", "kumomta-reload")

json.dump({"domain": domain, "selector": selector, "key_location": location, "dkim_record": record}, fp=sys.stdout)
