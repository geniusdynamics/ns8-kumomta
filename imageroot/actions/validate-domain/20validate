# Check the DNS records of one sending domain, or of all of them: DKIM TXT
# matching the key, SPF with the mechanism of this MTA, DMARC and the
# return path CNAME (recommended). Store and return the status (pending,
# verified, failed) and the time of the check. A verified domain can be
# used by the integrations.

import json
import sys
import agent
import kumomta_ns8 as kumo

request = json.load(sys.stdin) or {}
names = None
if request.get("domain"):
    dom = kumo.find_domain(kumo.load_settings(), request["domain"])
    if not dom:
        agent.set_status('validation-failed')
        json.dump([{'field': 'domain', 'parameter': 'domain', 'value': request["domain"],
                    'error': 'domain_not_found'}], fp=sys.stdout)
        sys.exit(3)
    names = [dom["domain"]]
views = kumo.validate_domains(names)
for view in views:
    print(f"{view['domain']}: {view['status']}", file=sys.stderr)
json.dump({"domains": views}, fp=sys.stdout)
