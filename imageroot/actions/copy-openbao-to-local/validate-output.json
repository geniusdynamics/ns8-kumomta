{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Copy the OpenBao-only secrets to the local storage",
    "$id": "http://nethserver.org/json-schema/task/output/kumomta/copy-openbao-to-local",
    "type": "object",
    "required": ["copied", "failed"],
    "properties": {
        "copied": {"type": "array", "items": {"type": "string"}},
        "failed": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {"name": {"type": "string"}, "error": {"type": "string"}}
            }
        }
    }
}
