# Role "clusterpeer": the other kumomta instances (authorization
# kumomta@any:clusterpeer of build-images.sh) may copy the cluster settings
# of this instance, the throttle store password included. Its name does not
# start with get-, list-, show- or read-: readers cannot run it.

set -e
exec 1>&2
redis-exec SADD "${AGENT_ID}/roles/clusterpeer" "reveal-cluster-settings"
