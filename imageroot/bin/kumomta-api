# Sending domain management API of the integrations (kumomta-api.service).
# Listens on 127.0.0.1, second TCP port of the module; Traefik routes /api/v1
# of the API host name here, over HTTPS. Every request needs the HTTP basic
# credentials of an integration with the "domains" scope; an integration
# sees and changes only the domains it added. See docs/api.md.
#
#   GET    /api/v1/whoami
#   GET    /api/v1/domains
#   POST   /api/v1/domains                    {"domain", "selector", "tenant", "dkim_private_key"}
#   GET    /api/v1/domains/<domain>
#   POST   /api/v1/domains/<domain>/validate
#   DELETE /api/v1/domains/<domain>

import base64
import hmac
import json
import socket
import sys
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

import kumomta_ns8 as kumo

MAX_BODY = 64 * 1024
RATE = 120              # authenticated requests per minute per integration
FAIL_LIMIT = 20        # failed authentications per minute per known integration
CHANGE_RATE = 12       # domain mutations per minute per integration
GLOBAL_CHANGE_RATE = 60
DOMAIN_QUOTA = 100     # active API-owned domains per integration
GLOBAL_DOMAIN_QUOTA = 1000

_buckets = {}
_lock = threading.Lock()
_last_cleanup = 0


def _rate_limit(*limits, charge=True):
    """Atomically enforce sliding one-minute budgets."""
    global _last_cleanup
    now = time.monotonic()
    with _lock:
        if now - _last_cleanup >= 60:
            for key in list(_buckets):
                if now - _buckets[key][-1] >= 60:
                    del _buckets[key]
            _last_cleanup = now
        updates = []
        for key, limit in limits:
            events = [t for t in _buckets.get(key, ()) if now - t < 60]
            if len(events) >= limit:
                return False
            updates.append((key, events))
        if charge:
            for key, events in updates:
                _buckets[key] = events + [now]
        return True


class Server(ThreadingHTTPServer):
    """Bound worker threads even when clients connect without sending a request."""
    _workers = threading.BoundedSemaphore(64)

    def process_request(self, request, client_address):
        if not self._workers.acquire(blocking=False):
            self.shutdown_request(request)
            return
        try:
            super().process_request(request, client_address)
        except Exception:
            self._workers.release()
            raise

    def process_request_thread(self, request, client_address):
        try:
            super().process_request_thread(request, client_address)
        finally:
            self._workers.release()


class Handler(BaseHTTPRequestHandler):
    server_version = "ns8-kumomta-api"
    sys_version = ""

    def setup(self):
        self.request.settimeout(10)
        super().setup()

    def log_message(self, fmt, *args):
        print("%s %s" % (self.headers.get("X-Forwarded-For", self.client_address[0]), fmt % args),
              file=sys.stderr)

    def reply(self, code, body):
        data = json.dumps(body).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        if code == 401:
            self.send_header("WWW-Authenticate", 'Basic realm="kumomta"')
        self.end_headers()
        self.wfile.write(data)

    def error(self, code, error, detail=""):
        self.reply(code, {"error": error, "detail": detail})

    def authenticate(self):
        """The integration dict, or None after an error reply"""
        name, password = "", ""
        header = self.headers.get("Authorization", "")
        if header[:6].lower() == "basic ":
            try:
                name, _, password = base64.b64decode(header[6:], validate=True).decode().partition(":")
            except ValueError:
                pass
        if not kumo.INTEGRATION_RE.fullmatch(name):
            self.error(401, "unauthorized")
            return None
        settings = kumo.load_settings()
        integ = next((i for i in settings["integrations"] if i["name"] == name), None)
        if not integ:
            self.error(401, "unauthorized")
            return None
        failure_bucket = (("auth_failure", name), FAIL_LIMIT)
        if not _rate_limit(failure_bucket, charge=False):
            self.error(429, "too_many_failures", "too many failed authentications, retry later")
            return None
        if not kumo.check_password(kumo.read_integrations_secrets().get(name), password):
            _rate_limit(failure_bucket)
            self.error(401, "unauthorized")
            return None
        if "domains" not in (integ.get("scopes") or []):
            self.error(403, "forbidden", "the credential has no 'domains' scope")
            return None
        if not _rate_limit((("requests", name), RATE)):
            self.error(429, "rate_limited", f"more than {RATE} requests per minute")
            return None
        return integ

    def verify_local_auth(self):
        # This path sits outside the Traefik routes. Other processes on
        # the host can reach loopback, so also require the module secret.
        token = kumo.read_secret("api_password")
        presented = self.headers.get("X-Kumo-Local-Token", "")
        if not token or not hmac.compare_digest(token.encode(), presented.encode()):
            self.error(401, "unauthorized")
            return
        data = self.body()
        scope, name, password = (data.get(k, "") for k in ("scope", "name", "password"))
        if not isinstance(name, str) or not isinstance(password, str):
            raise ValueError("invalid credentials")
        cred = None
        if scope == "smtp" and kumo.USERNAME_RE.fullmatch(name):
            cred = kumo.read_smtp_users().get(name)
        if not cred and scope in ("smtp", "inject") and kumo.INTEGRATION_RE.fullmatch(name):
            integration = next((i for i in kumo.load_settings()["integrations"] if i["name"] == name), None)
            if integration and scope in (integration.get("scopes") or []):
                cred = kumo.read_integrations_secrets().get(name)
        self.reply(200 if kumo.check_password(cred, password) else 401, {})

    def body(self):
        length = int(self.headers.get("Content-Length") or 0)
        if not 0 <= length <= MAX_BODY:
            raise ValueError("invalid body length")
        raw = self.rfile.read(length) if length else b"{}"
        if len(raw) != length and length:
            raise ValueError("incomplete request body")
        data = json.loads(raw)
        if not isinstance(data, dict):
            raise ValueError("a JSON object is expected")
        return data

    def route(self):
        path = self.path.split("?", 1)[0].rstrip("/")
        parts = path.split("/")[1:]   # api, v1, ...
        if parts[:2] != ["api", "v1"]:
            return None
        return parts[2:]

    def handle_any(self, method):
        try:
            if method == "POST" and self.path == "/_ns8/verify-auth":
                self.verify_local_auth()
                return
            parts = self.route()
            if parts is None:
                self.error(404, "not_found")
                return
            integ = self.authenticate()
            if integ is None:
                return
            name = integ["name"]
            if method in ("POST", "DELETE") and parts[:1] == ["domains"]:
                if not _rate_limit((("changes", name), CHANGE_RATE), ("global_changes", GLOBAL_CHANGE_RATE)):
                    self.error(429, "rate_limited", "too many domain changes, retry later")
                    return
            if parts == ["whoami"] and method == "GET":
                self.reply(200, {"name": name, "tenant": integ.get("tenant") or "",
                                 "scopes": integ.get("scopes") or [],
                                 "max_message_rate": integ.get("max_message_rate") or ""})
            elif parts == ["domains"] and method == "GET":
                settings = kumo.load_settings()
                self.reply(200, {"domains": [kumo.domain_view(settings, d) for d in settings["domains"]
                                             if (d.get("owner") or "") == name],
                                 "require_verified_domains": bool(settings["require_verified_domains"])})
            elif parts == ["domains"] and method == "POST":
                data = self.body()
                tenant = data.get("tenant") or ""
                if tenant and tenant != (integ.get("tenant") or ""):
                    self.error(422, "invalid_tenant", "the credential is bound to its own tenant")
                    return
                with kumo.settings_lock():
                    settings = kumo.load_settings()
                    tenant = integ.get("tenant") or ""
                    owned = [d for d in settings["domains"] if d.get("owner")]
                    if len(owned) >= GLOBAL_DOMAIN_QUOTA or sum(d["owner"] == name for d in owned) >= DOMAIN_QUOTA:
                        self.error(429, "domain_quota", "active domain quota reached")
                        return
                    private_key = data.get("dkim_private_key")
                    if private_key is not None and not isinstance(private_key, str):
                        raise ValueError("dkim_private_key must be a string")
                    entry = kumo.add_domain(settings, str(data.get("domain") or ""), str(data.get("selector") or ""),
                                            name, tenant, private_key or None)
                    kumo.save_settings(settings)
                    kumo.apply_policy()
                self.reply(201, kumo.domain_view(settings, entry))
            elif len(parts) in (2, 3) and parts[0] == "domains":
                settings = kumo.load_settings()
                dom = kumo.find_domain(settings, parts[1])
                if not dom or (dom.get("owner") or "") != name:
                    self.error(404, "domain_not_found", parts[1])
                elif len(parts) == 2 and method == "GET":
                    self.reply(200, kumo.domain_view(settings, dom))
                elif len(parts) == 2 and method == "DELETE":
                    with kumo.settings_lock():
                        settings = kumo.load_settings()
                        kumo.remove_domain(settings, parts[1], owner=name)
                        kumo.save_settings(settings)
                        kumo.apply_policy()
                    self.reply(200, {"domain": dom["domain"], "removed": True})
                elif len(parts) == 3 and parts[2] == "validate" and method == "POST":
                    views = kumo.validate_domains([dom["domain"]], owner=name)
                    if views:
                        self.reply(200, views[0])
                    else:
                        self.error(404, "domain_not_found", parts[1])
                else:
                    self.error(405, "method_not_allowed")
            else:
                self.error(404, "not_found")
        except kumo.DomainError as ex:
            if ex.code in ("domain_exists", "local_key_conflict", "shared_key_exists"):
                code = 409
            elif ex.code == "domain_not_found":
                code = 404
            else:
                code = 422
            self.error(code, ex.code, ex.value)
        except kumo.PasswordVerifierBusy:
            self.error(503, "auth_busy", "credential verification is busy, retry later")
        except (BrokenPipeError, ConnectionResetError, socket.timeout):
            return
        except ValueError as ex:
            self.error(400, "bad_request", str(ex))
        except Exception as ex:
            print(f"Request failed: {ex!r}", file=sys.stderr)
            self.error(500, "internal_error")

    def do_GET(self):
        self.handle_any("GET")

    def do_POST(self):
        self.handle_any("POST")

    def do_DELETE(self):
        self.handle_any("DELETE")


def main():
    port = kumo.daemon_port()
    if not port:
        print("No second TCP port (TCP_PORTS): the domain API is not available", file=sys.stderr)
        # Nothing to serve: stay idle instead of a restart loop
        while True:
            time.sleep(3600)
    server = Server(("127.0.0.1", int(port)), Handler)
    server.daemon_threads = True
    print(f"Listening on 127.0.0.1:{port}", file=sys.stderr)
    server.serve_forever()


if __name__ == "__main__":
    main()
