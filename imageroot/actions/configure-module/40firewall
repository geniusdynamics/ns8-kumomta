# Open the enabled SMTP listener ports on the node firewall, like ns8-mail

import os
import agent
import kumomta_ns8 as kumo

settings = kumo.load_settings()
ports = [f"{port}/tcp" for port in kumo.listener_ports(settings)]
agent.assert_exp(agent.add_public_service(os.environ['MODULE_ID'], ports, replace_ports=True),
                 "add-public-service failed")
