# "Request access from OpenBao": record an access request on the ns8-openbao
# instance (request-client-access, with the cluster group when clustered).
# When the module is already approved and provisioned mode is on, the token
# is provisioned at once and the policy rendered again. No secret in the
# output.

import json
import os
import subprocess
import sys
import agent
import kumomta_ns8 as kumo
import openbao_client
from openbao_client import ClientError

data = json.load(sys.stdin)
settings = kumo.load_settings()
provider = data.get("openbao_module_id") or settings.get("vault_provider") or ""
if not provider:
    agent.set_status('validation-failed')
    json.dump([{'field': 'openbao_module_id', 'parameter': 'openbao_module_id', 'value': '',
                'error': 'required'}], fp=sys.stdout)
    sys.exit(3)
group = kumo.cluster_group(settings)
try:
    status = openbao_client.request_access(provider, False, [group] if group else [])
except ClientError as ex:
    agent.set_status('validation-failed')
    json.dump([{'field': 'openbao_module_id', 'parameter': 'openbao_module_id', 'value': provider,
                'error': ex.code}], fp=sys.stdout)
    sys.exit(3)

result = ""
if status.get("status") == "approved" and settings["vault_enabled"] \
        and settings.get("vault_auth") == "provisioned" and settings.get("vault_provider") == provider:
    with kumo.settings_lock():
        settings = kumo.load_settings()
        previous = kumo.vault_view(settings)
        result, _ = kumo.provisioned_client_step(settings, previous)
        changed, restart = kumo.write_config(settings)
    if restart:
        subprocess.run(["systemctl", "--user", "try-restart", "kumomta.service"], check=False)
    elif changed:
        subprocess.run(["kumomta-reload"], check=False)
json.dump({"status": status.get("status", "none"), "provisioning": result,
           "client": openbao_client.public_state()}, fp=sys.stdout)
