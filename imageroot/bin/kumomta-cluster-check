# Cluster health check of the instance (docs/cluster.md):
#
#   kumomta-cluster-check              timer: hysteresis, restart if needed
#   kumomta-cluster-check --now        events: no hysteresis
#   kumomta-cluster-check --prestart   ExecStartPre of kumomta.service
#
# A standalone instance exits at once.

import sys
import kumomta_ns8 as kumo

prestart = "--prestart" in sys.argv
immediate = "--now" in sys.argv
try:
    state = kumo.cluster_check(prestart=prestart, immediate=immediate)
except Exception as ex:
    print(f"Cluster check failed: {ex}", file=sys.stderr)
    sys.exit(1)
