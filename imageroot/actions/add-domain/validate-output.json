{
    "type": "object",
    "required": [
        "domain",
        "selector",
        "status",
        "records"
    ],
    "properties": {
        "domain": {
            "type": "string"
        },
        "selector": {
            "type": "string"
        },
        "key_location": {
            "type": "string",
            "enum": [
                "local",
                "local_not_in_openbao",
                "openbao",
                "missing"
            ]
        },
        "dkim_record": {
            "type": [
                "object",
                "null"
            ],
            "properties": {
                "name": {
                    "type": "string"
                },
                "type": {
                    "type": "string"
                },
                "value": {
                    "type": "string"
                }
            }
        },
        "owner": {
            "type": "string",
            "description": "Integration that added the domain through the API, empty for the administrator"
        },
        "tenant": {
            "type": "string"
        },
        "status": {
            "type": "string",
            "enum": [
                "pending",
                "verified",
                "failed"
            ]
        },
        "last_checked": {
            "type": "string",
            "description": "ISO 8601 UTC time of the last DNS check, empty if never checked"
        },
        "checks": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "required": {
                        "type": "boolean"
                    },
                    "status": {
                        "type": "string",
                        "enum": [
                            "pass",
                            "fail",
                            "missing"
                        ]
                    },
                    "detail": {
                        "type": "string"
                    }
                }
            }
        },
        "records": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "check": {
                        "type": "string"
                    },
                    "required": {
                        "type": "boolean"
                    },
                    "type": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "value": {
                        "type": "string"
                    },
                    "purpose": {
                        "type": "string"
                    }
                }
            }
        }
    },
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Added sending domain",
    "$id": "http://nethserver.org/json-schema/task/output/kumomta/add-domain"
}