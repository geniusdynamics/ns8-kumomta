#
# Sending domain management API of the integrations (kumomta-api), on
# 127.0.0.1, second TCP port of the module. Traefik routes /api/v1 of the
# API host name here. This service also verifies SMTP and HTTP injection
# credentials over a separate, token-protected loopback endpoint.
#

[Unit]
Description=KumoMTA domain management API for sending platforms

[Service]
EnvironmentFile=%S/state/environment
WorkingDirectory=%S/state
ExecStart=runagent kumomta-api
Restart=always
RestartSec=5
SyslogIdentifier=%N

[Install]
WantedBy=default.target
