# Traefik obtained or renewed a certificate: if it is the one of the MTA
# host name, give it to kumod, like ns8-mail does. kumod re-reads the
# certificate files within 5 minutes; the epoch bump makes it immediate.

import json
import os
import sys
import agent
import kumomta_ns8 as kumo

event = json.load(sys.stdin)
myname = kumo.load_settings()["hostname"]

if not myname or not agent.certificate_event_matches(event, myname):
    sys.exit(0) # ignore event if not relevant

os.makedirs(kumo.TLS_DIR, mode=0o700, exist_ok=True)
get_proc = agent.run_helper('get-certificate', f'--cert-file={kumo.TLS_DIR}/cert.pem',
                            f'--key-file={kumo.TLS_DIR}/key.pem', myname)
if get_proc.returncode == 0:
    os.chmod(f"{kumo.TLS_DIR}/key.pem", 0o600)
    agent.run_helper('systemctl', '--user', 'try-reload-or-restart', 'kumomta.service')
