{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Get kumomta settings",
    "$id": "http://nethserver.org/json-schema/task/output/kumomta/get-configuration",
    "description": "KumoMTA settings. Secrets are never returned, only the *_set markers.",
    "type": "object",
    "required": [
        "hostname",
        "inbound_enabled",
        "inbound_port",
        "submission_enabled",
        "submission_port",
        "vault_enabled",
        "vault_token_set",
        "domains",
        "smtp_users"
    ],
    "properties": {
        "hostname": {
            "type": "string"
        },
        "lets_encrypt": {
            "type": "boolean",
            "description": "Request a Let's Encrypt certificate for the host name (and the metrics host name)"
        },
        "inbound_enabled": {
            "type": "boolean",
            "description": "Enable the inbound (MX) SMTP listener"
        },
        "inbound_port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535,
            "description": "Port of the inbound listener, normally 25"
        },
        "submission_enabled": {
            "type": "boolean",
            "description": "Enable the submission listener (STARTTLS + AUTH)"
        },
        "submission_port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535,
            "description": "Port of the submission listener, normally 587"
        },
        "max_message_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1024,
            "description": "Maximum message size, in MiB"
        },
        "relay_networks": {
            "type": "array",
            "items": {
                "type": "string",
                "maxLength": 64
            },
            "description": "IP addresses and CIDR networks allowed to relay without authentication"
        },
        "cluster_relay": {
            "type": "boolean",
            "description": "Offer the MTA as smarthost to the cluster: relay from the cluster network and publish the submission service"
        },
        "smtp_users": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "username"
                ],
                "properties": {
                    "username": {
                        "type": "string"
                    }
                },
                "additionalProperties": false
            }
        },
        "domains": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "domain",
                    "selector",
                    "key_location"
                ],
                "properties": {
                    "domain": {
                        "type": "string"
                    },
                    "selector": {
                        "type": "string"
                    },
                    "key_location": {
                        "type": "string",
                        "enum": [
                            "local",
                            "local_not_in_openbao",
                            "openbao",
                            "missing"
                        ]
                    },
                    "dkim_record": {
                        "type": [
                            "object",
                            "null"
                        ],
                        "properties": {
                            "name": {
                                "type": "string"
                            },
                            "type": {
                                "type": "string"
                            },
                            "value": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "inbound_routes": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "domain",
                    "host"
                ],
                "properties": {
                    "domain": {
                        "type": "string",
                        "minLength": 3,
                        "maxLength": 253
                    },
                    "host": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 253
                    },
                    "port": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 65535
                    }
                },
                "additionalProperties": false
            },
            "description": "Domains accepted from anyone and relayed to an internal server"
        },
        "smarthost_enabled": {
            "type": "boolean"
        },
        "smarthost_host": {
            "type": "string",
            "maxLength": 253
        },
        "smarthost_port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
        },
        "smarthost_tls": {
            "type": "string",
            "enum": [
                "required",
                "required_insecure",
                "opportunistic",
                "disabled"
            ]
        },
        "smarthost_username": {
            "type": "string",
            "maxLength": 256
        },
        "shaping": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "domain"
                ],
                "properties": {
                    "domain": {
                        "type": "string",
                        "minLength": 3,
                        "maxLength": 253
                    },
                    "connection_limit": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 10000
                    },
                    "max_message_rate": {
                        "type": "string",
                        "maxLength": 32
                    },
                    "max_deliveries_per_connection": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 100000
                    }
                },
                "additionalProperties": false
            },
            "description": "Per-destination traffic shaping"
        },
        "retry_interval": {
            "type": "string",
            "maxLength": 32,
            "description": "First retry interval of deferred messages, e.g. 20m"
        },
        "max_age": {
            "type": "string",
            "maxLength": 32,
            "description": "Messages still undelivered after this time bounce, e.g. 5d"
        },
        "webhook_enabled": {
            "type": "boolean"
        },
        "webhook_url": {
            "type": "string",
            "maxLength": 2048
        },
        "webhook_record_types": {
            "type": "array",
            "items": {
                "type": "string",
                "enum": [
                    "Reception",
                    "Delivery",
                    "Bounce",
                    "TransientFailure",
                    "Expiration",
                    "AdminBounce",
                    "OOB",
                    "Feedback",
                    "Rejection"
                ]
            }
        },
        "vault_enabled": {
            "type": "boolean",
            "description": "Read the secrets from OpenBao/Vault (KV v2)"
        },
        "vault_address": {
            "type": "string",
            "maxLength": 2048,
            "description": "VAULT_ADDR, e.g. https://vault.example.org"
        },
        "vault_mount": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._/-]{1,128}$"
        },
        "vault_path": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._/-]{1,256}$"
        },
        "vault_key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{0,128}$",
            "description": "Field name of the secrets, empty for the KumoMTA default 'key'"
        },
        "metrics_host": {
            "type": "string"
        },
        "metrics_allowlist": {
            "type": "array",
            "items": {
                "type": "string",
                "maxLength": 64
            }
        },
        "smarthost_password_set": {
            "type": "boolean"
        },
        "webhook_token_set": {
            "type": "boolean"
        },
        "metrics_password_set": {
            "type": "boolean"
        },
        "vault_token_set": {
            "type": "boolean"
        },
        "cluster_relay_active": {
            "type": "boolean"
        },
        "cluster_network": {
            "type": "string"
        },
        "node_address": {
            "type": "string"
        },
        "mail_modules": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "api_port": {
            "type": "integer"
        },
        "sink_enabled": {
            "type": "boolean"
        },
        "warnings": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "id",
                    "message"
                ],
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "message": {
                        "type": "string"
                    }
                }
            }
        }
    },
    "additionalProperties": false
}
