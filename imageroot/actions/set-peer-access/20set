import json
import sys

from kumomta_peer_access import set_peer_access

# An owner action. The reader and clusterpeer roles cannot modify grants.
data = json.load(sys.stdin)
set_peer_access(data["peer"], data["allowed"])
json.dump({"peer": data["peer"], "allowed": data["allowed"]}, sys.stdout)
