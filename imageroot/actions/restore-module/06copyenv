# The settings are in state/settings.json, restored by restic in the
# inherited 10restore step: nothing to copy from the environment here
# except the non-secret values the units read before configure-module.

import sys
import json
import agent

request = json.load(sys.stdin)
original_environment = request['environment']

for evar in ["KUMO_HOSTNAME", "KUMO_INBOUND_PORT", "KUMO_SUBMISSION_PORT"]:
    if evar in original_environment:
        agent.set_env(evar, original_environment[evar])

agent.dump_env()
