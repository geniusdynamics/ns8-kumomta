{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Add a sending domain",
    "$id": "http://nethserver.org/json-schema/task/input/kumomta/add-domain",
    "examples": [{"domain": "example.org"}, {"domain": "customer.example", "selector": "s1", "owner": "platform1", "tenant": "customer-42"}],
    "type": "object",
    "required": ["domain"],
    "properties": {
        "domain": {"type": "string", "minLength": 3, "maxLength": 253},
        "selector": {"type": "string", "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"},
        "owner": {"type": "string", "maxLength": 32, "description": "Integration that owns the domain, empty for the administrator"},
        "tenant": {"type": "string", "maxLength": 64},
        "dkim_private_key": {"type": "string", "maxLength": 16384, "description": "Optional PEM private key to import instead of generating one. Never returned"}
    },
    "additionalProperties": false
}
