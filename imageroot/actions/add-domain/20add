# Add a sending domain: install its DKIM key (generated, or the given PEM
# key) and return the DNS records to publish. The domain stays "pending"
# until validate-domain finds its records. "owner" assigns it to an
# integration, as if that integration had added it through the API.

import json
import sys
import agent
import kumomta_ns8 as kumo

request = json.load(sys.stdin)
with kumo.settings_lock():
    settings = kumo.load_settings()
    owner = request.get("owner") or ""
    if owner and owner not in [i["name"] for i in settings["integrations"]]:
        agent.set_status('validation-failed')
        json.dump([{'field': 'owner', 'parameter': 'owner', 'value': owner, 'error': 'integration_not_found'}], fp=sys.stdout)
        sys.exit(3)
    try:
        entry = kumo.add_domain(settings, request["domain"], request.get("selector"), owner,
                                request.get("tenant") or "", request.get("dkim_private_key"))
    except kumo.DomainError as ex:
        agent.set_status('validation-failed')
        field = 'dkim_private_key' if ex.code == 'invalid_private_key' else 'domain'
        json.dump([{'field': field, 'parameter': field, 'value': ex.value, 'error': ex.code}], fp=sys.stdout)
        sys.exit(3)
    entry["tenant_from_admin"] = True
    kumo.save_settings(settings)
    kumo.apply_policy()
json.dump(kumo.domain_view(settings, entry), fp=sys.stdout)
