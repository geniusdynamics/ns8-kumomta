# Generate (or rotate) the DKIM key of a sending domain and return the DNS
# TXT record to publish. With OpenBao enabled the private key is written to
# OpenBao (KV v2, <vault_path>/dkim/<domain>/<selector>) and removed from
# the state directory: an existing local key is moved there unless
# "rotate" is set. Only the public key stays on disk.

import json
import os
import sys
import agent
import kumomta_ns8 as kumo

request = json.load(sys.stdin)
settings = kumo.load_settings()
domain = request["domain"].lower()
entry = next((d for d in settings["domains"] if d["domain"] == domain), None)
if entry is None:
    agent.set_status('validation-failed')
    json.dump([{'field': 'domain', 'parameter': 'domain', 'value': domain, 'error': 'domain_not_found'}], fp=sys.stdout)
    sys.exit(3)
selector = entry["selector"]
keyfile, _ = kumo.dkim_paths(domain, selector)

if os.path.exists(keyfile) and not request.get("rotate"):
    with open(keyfile) as fp:
        pem = fp.read()
    public = kumo.public_from_private(pem)
else:
    pem, public = kumo.generate_dkim_key()

if settings["vault_enabled"]:
    try:
        kumo.openbao_write(settings, kumo.dkim_vault_path(settings, domain, selector), pem)
    except RuntimeError as ex:
        print(agent.SD_ERR + str(ex), file=sys.stderr)
        agent.set_status('validation-failed')
        json.dump([{'field': 'domain', 'parameter': 'domain', 'value': domain, 'error': 'openbao_write_failed'}], fp=sys.stdout)
        sys.exit(3)
    if os.path.exists(keyfile):
        os.unlink(keyfile)
    location = "openbao"
else:
    kumo.store_dkim_private(domain, selector, pem)
    location = "local"
kumo.store_dkim_public(domain, selector, public)

# kumod caches the signers: a configuration epoch bump drops them
if agent.run_helper("systemctl", "--user", "-q", "is-active", "kumomta.service").returncode == 0:
    agent.run_helper("runagent", "kumomta-reload")

json.dump({"domain": domain, "selector": selector, "key_location": location,
           "dkim_record": kumo.dkim_record(domain, selector)}, fp=sys.stdout)
